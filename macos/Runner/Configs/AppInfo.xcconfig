// Application-level settings for the Runner target.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = yintrace

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = io.github.zhikkz.yintrace

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 zhikkz. Licensed under the GNU AGPL v3.

// The audio core is linked statically into the app; keep its C symbols
// visible to dart:ffi.
STRIP_STYLE = non-global
